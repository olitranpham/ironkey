# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ironkey"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Platform (Ironkey) secret key — never expose to clients
STRIPE_SECRET_KEY="sk_live_..."
# OAuth client ID from Stripe Dashboard → Connect → Settings
# Must be NEXT_PUBLIC_ so the browser can build the OAuth URL without hitting the API
STRIPE_CLIENT_ID="ca_..."
NEXT_PUBLIC_STRIPE_CLIENT_ID="ca_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# HMAC key for signing the Stripe Connect OAuth `state` param
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STRIPE_STATE_SECRET="generate-a-long-random-string-here"

# ─── Seam (smart-lock access control) ────────────────────────────────────────
SEAM_API_KEY="seam_apikey_..."

# ─── Migration (one-time) ─────────────────────────────────────────────────────
# Source database for scripts/migrate-triumph.js
OLD_DATABASE_URL="postgresql://USER:PASSWORD@old-host:5432/triumph_db"

# ─── Webhook / external integrations (Zapier etc.) ───────────────────────────
# Shared secret for Zapier → POST /api/[gymSlug]/members and /api/[gymSlug]/guest-passes.
# Send it as the header:  x-webhook-secret: <secret>
# (Legacy "Authorization: Bearer <secret>" is still accepted, with a log warning.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET="generate-a-long-random-string-here"
# "true" → reject calls to those routes that carry neither a staff JWT nor the secret (401).
# Anything else → allow them but log "[webhook-unauth] route=… gym=…" (rollout mode).
# Turn on once Zapier sends the secret and the warnings stop.
WEBHOOK_ENFORCE="false"

# ─── Super-admin ──────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@ironkeyentry.com"
# bcrypt hash of the superadmin password. Generate with:
#   node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" 'your-password'
# In .env files escape each $ as \$ (Next.js expands $VARS in .env).
ADMIN_PASSWORD_HASH=""
# Legacy plaintext fallback — only used (with a warning) when ADMIN_PASSWORD_HASH is unset
ADMIN_PASSWORD=""

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Random secret used to authenticate POST /api/[gymSlug]/overdue-cancel
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="generate-a-long-random-string-here"
