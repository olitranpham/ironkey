generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Gym ──────────────────────────────────────────────────────────────────────

model Gym {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("America/New_York")

  // Stripe – one customer per gym
  stripeCustomerId     String?
  stripeSecretKey      String?
  stripeWebhookSecret  String?
  stripeAccountId      String?   // Stripe Connect – connected account ID (acct_...)

  // Seam – smart-lock integration (optional)
  seamConnectedAccountId String?
  seamApiKey             String?
  seamDeviceId           String?

  // Door-access provider selection — defaults to Seam for every existing
  // gym; Kisi fields below are only read when accessProvider is KISI.
  accessProvider    AccessProvider @default(SEAM)
  kisiApiKey        String?
  kisiPlaceId       String?
  kisiMemberGroupId String?
  kisiWeekendGroupId String?

  // REP Gym Pass integration
  repGymPassEnabled Boolean @default(false)

  // Branding
  logoUrl String?

  // Zapier webhook URLs for outbound notifications
  // Shared front-door lockbox code shown to guests/members after a PAID checkout (owner-set)
  lockboxCode                        String?

  zapierGuestWebhookUrl              String?
  // Zapier "lead invite" — emails a lead their personalised join link
  leadWebhookUrl                     String?
  zapierMemberWebhookUrl             String?
  zapierOverdueWebhookUrl            String?
  zapierMembershipRequestWebhookUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members              Member[]
  guestVisits          GuestVisit[]
  guestWaivers         GuestWaiver[]
  users                GymUser[]
  financialEntries     FinancialEntry[]
  inventoryItems       InventoryItem[]
  repGymPassCheckins   RepGymPassCheckin[]
  personalTrainers     PersonalTrainer[]
  ptSessions           PTSession[]
  ptIntakes            PTIntake[]
  membershipRequests   MembershipRequest[]
  auditLogs            AuditLog[]
  leads                Lead[]
  guestCheckIns        GuestCheckIn[]
  couponRedemptions    CouponRedemption[]
}

// ─── Member ───────────────────────────────────────────────────────────────────

model Member {
  id        String       @id @default(cuid())
  gymId     String
  gym       Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String
  phone     String?

  status         MemberStatus @default(ACTIVE)
  membershipType String       @default("general")

  // Stripe
  stripeCustomerId     String?
  stripeSubscriptionId String?
  priceId              String?

  // Personal info collected at signup
  dateOfBirth           String?
  address               String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  // Guardian info — populated when the member was a minor (under 18) at
  // signup. The guardian is the account holder (payer + waiver signer);
  // firstName/lastName/dateOfBirth above remain the minor's own info.
  isMinor              Boolean @default(false)
  guardianName         String?
  guardianEmail        String?
  guardianPhone        String?
  guardianRelationship String?

  // Membership agreement typed signature (the guardian's for a minor),
  // set by the join checkout. Null for members who joined before typed
  // signatures, or were added by staff / imported.
  agreementSignedAt           DateTime?
  agreementSignatureName      String?
  agreementSignatureIp        String?
  agreementSignatureUserAgent String?
  // Exact agreement text signed (lib/agreements) and its version
  agreementText               String?
  agreementVersion            String?

  // Seam / smart-lock access code
  accessCode       String?
  seamDeviceId     String?

  // Kisi — only set for members of a gym with accessProvider KISI
  kisiUserId           String?
  kisiRoleAssignmentId String?

  // Freeze window (Ironkey-native)
  freezeStartDate  DateTime?
  freezeEndDate    DateTime?

  // Legacy date fields preserved from old Triumph DB
  dateAccessed DateTime?
  dateFrozen   DateTime?
  dateCanceled DateTime?
  maxFreeze    DateTime?

  // Flex membership monthly check-in tracking
  flexCheckInCount     Int       @default(0)
  flexCheckInResetDate DateTime?

  // Cancellation scheduled (cancel_at_period_end on Stripe — still ACTIVE until period ends)
  cancelScheduled     Boolean   @default(false)
  // When that scheduled cancellation actually takes effect — mirrors
  // whichever of Stripe's cancel_at_period_end (-> current_period_end) or
  // explicit cancel_at the /cancel route used. Null once cancelScheduled
  // is false (cleared by /reverse-cancel, or by the subscription.deleted
  // webhook once it's actually happened).
  cancelEffectiveDate DateTime?

  // Student membership fields
  studentIdImage String? // base64 data URL of uploaded student ID photo
  studentIdStatus     String?   // "pending" | "approved" | "rejected"
  studentIdReviewedAt DateTime?
  studentIdReviewedBy String?   // GymUser email

  // Student graduation tracking — captured at signup via the join flow, and
  // editable afterward from the member profile drawer
  gradSemester    String? // "Fall" | "Spring" | "Summer"
  gradYear        Int?
  studentCategory String? // "Student" | "Military" | "EMT" — Hydra's bundled plan only

  // Referral
  hearAboutUs String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guestVisits      GuestVisit[]
  membershipEvents MembershipEvent[]
  ptSessions       PTSessionMember[]
  couponRedemptions CouponRedemption[]

  @@unique([gymId, email])
}

enum AccessProvider {
  SEAM
  KISI
}

enum MemberStatus {
  ACTIVE
  FROZEN
  CANCELED
  OVERDUE
}

// ─── Guest ────────────────────────────────────────────────────────────────────
// Global — shared across gyms by email. Per-gym waiver records live in GuestWaiver.

model Guest {
  id         String   @id @default(cuid())

  name       String
  email      String?  @unique
  phone      String?
  accessCode String?

  dateOfBirth                  String?
  address                      String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  // Guardian info — populated when the guest was a minor (under 18) at
  // signup. The guardian is the point of contact (payer + waiver signer);
  // name/dateOfBirth above remain the minor guest's own info.
  isMinor              Boolean @default(false)
  guardianName         String?
  guardianEmail        String?
  guardianPhone        String?
  guardianRelationship String?

  passes   GuestVisit[]
  waivers  GuestWaiver[]
  leads    Lead[]
  checkIns GuestCheckIn[]
  couponRedemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("GuestProfile")
}

// ─── GuestVisit ───────────────────────────────────────────────────────────────
// Each individual pass purchase or check-in record.

model GuestVisit {
  id        String  @id @default(cuid())
  gymId     String
  gym       Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)

  memberId  String?
  member    Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  guestProfileId String?
  guestProfile   Guest?  @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)

  guestName  String
  guestEmail String?
  guestPhone String?

  passType   PassType  @default(SINGLE)
  passesLeft Int?

  // Student ID photo — base64 data URL, required for "Student Pass" type
  // purchases. Scoped here (not on Guest) since Guest is shared globally
  // across gyms by email, but a photo proves student status for one
  // specific pass purchase at one specific gym.
  studentIdImage String?

  usedAt    DateTime?
  expiresAt DateTime

  // Stripe session.amount_total in cents — set by the platform webhook for
  // purchases from this point on; null for older passes
  amountPaid Int?

  // Checkout session that created this pass — unique, so a repeated webhook
  // delivery can't create a second row. Null for Zapier/imported passes.
  stripeSessionId String? @unique
  stripePriceId   String?
  // Passes in the purchased pack (1 for a single), resolved from the price
  // ID at purchase. Null for older passes — see packSizeForPass().
  packSize        Int?

  checkIns   GuestCheckIn[]

  createdAt DateTime @default(now())

  @@map("GuestPass")
}

enum PassType {
  SINGLE
  THREE_PACK
  FIVE_PACK
  TEN_PACK
  VALUE
  DELUXE
}

// ─── PTIntake ─────────────────────────────────────────────────────────────────
// Stores PT intake form responses submitted after a PT/programming checkout.

model PTIntake {
  id        String   @id @default(cuid())
  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  name      String?
  email     String
  phone     String?
  goals             String?
  experience        String?
  injuriesConditions String?
  additionalInfo    String?
  consultationTime  String?

  createdAt DateTime @default(now())

  @@index([gymId, email])
}

// ─── StudentIdUpload ──────────────────────────────────────────────────────────
// Temporary holding table for student ID files uploaded during join form.
// The webhook copies the data to the Member record and deletes this row.

model StudentIdUpload {
  id        String   @id @default(cuid())
  gymId     String
  email     String
  fileData  String   // base64 data URL of the uploaded student ID photo
  createdAt DateTime @default(now())

  @@index([gymId, email])
}

// ─── GuestWaiver ──────────────────────────────────────────────────────────────
// Records that a guest has signed the waiver at a specific gym.

model GuestWaiver {
  id             String   @id @default(cuid())
  guestProfileId String
  gymId          String
  signedAt       DateTime @default(now())

  // Typed signature (the guardian's for a minor) and where it was signed.
  // Null on rows from before typed signatures (accepted by checkbox).
  signatureName      String?
  signatureIp        String?
  signatureUserAgent String?
  // Exact waiver text signed (lib/agreements) and its version. Null on rows
  // from before snapshots.
  waiverText         String?
  waiverVersion      String?

  guestProfile   Guest @relation(fields: [guestProfileId], references: [id])
  gym            Gym   @relation(fields: [gymId], references: [id])

  @@unique([guestProfileId, gymId])
}

// ─── GuestCheckIn ────────────────────────────────────────────────────────────
// One row per successful kiosk guest check-in (from this point on; no backfill).

model GuestCheckIn {
  id             String     @id @default(cuid())
  gymId          String
  gym            Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  guestPassId    String
  guestPass      GuestVisit @relation(fields: [guestPassId], references: [id], onDelete: Cascade)
  guestProfileId String?
  guestProfile   Guest?     @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())

  @@index([gymId, guestProfileId])
  @@index([guestPassId])
}

// ─── Lead ────────────────────────────────────────────────────────────────────
// Staff-tracked status for a guest who isn't a member yet. A row exists only
// once staff act on the lead (or it converts); no row = status "new".

model Lead {
  id             String    @id @default(cuid())
  gymId          String
  gym            Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  guestProfileId String
  guestProfile   Guest     @relation(fields: [guestProfileId], references: [id], onDelete: Cascade)
  status         String    @default("new")   // 'new' | 'contacted' | 'converted'
  contactedAt    DateTime?
  convertedAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([gymId, guestProfileId])
}

// ─── CouponRedemption ─────────────────────────────────────────────────────────
// One row per paid checkout that used a once-per-customer promotion code
// (promotion code metadata ironkey_once_per_customer=true). Identity is the
// normalized buyer email; guestProfileId / memberId are filled when that email
// resolves to a guest profile with a pass here / a member of this gym.
// Written by the platform webhook on checkout.session.completed.

model CouponRedemption {
  id                String   @id @default(cuid())
  gymId             String
  gym               Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  promotionCodeId   String
  code              String
  email             String   // trimmed + lowercased
  guestProfileId    String?
  guestProfile      Guest?   @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)
  memberId          String?
  member            Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  checkoutSessionId String   @unique
  source            String   // 'join' | 'guest_pass' | 'concessions'
  createdAt         DateTime @default(now())

  @@unique([gymId, promotionCodeId, email])
}

// ─── RepGymPassCheckin ────────────────────────────────────────────────────────
// Records each check-in initiated by the REP Gym Pass partner integration.

model RepGymPassCheckin {
  id              String   @id @default(cuid())
  gymId           String
  gym             Gym      @relation(fields: [gymId], references: [id])
  userName        String
  userEmail       String
  accessCode      String
  startsAt        DateTime
  expiresAt       DateTime
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())

  @@index([gymId])
}

// ─── GymUser (staff / admin accounts) ────────────────────────────────────────

model GymUser {
  id       String      @id @default(cuid())
  gymId    String
  gym      Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)

  email    String
  password String      // bcrypt hash

  role     GymUserRole @default(STAFF)

  // RBAC — effective permissions = (role defaults ∪ permAdd) − permRemove (see lib/permissions.js)
  permAdd    String[] @default([])
  permRemove String[] @default([])
  active     Boolean  @default(true)

  // TRAINER logins link to their calendar record
  personalTrainerId String?          @unique
  personalTrainer   PersonalTrainer? @relation(fields: [personalTrainerId], references: [id], onDelete: SetNull)

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gymId, email])
}

enum GymUserRole {
  OWNER
  ADMIN
  STAFF
  TRAINER
}

// ─── AuditLog ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  gymId      String
  gym        Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  actorId    String?  // null = superadmin / webhook / cron
  actor      GymUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action     String
  targetType String
  targetId   String?
  meta       Json?

  createdAt  DateTime @default(now())

  @@index([gymId, createdAt])
}

// ─── MembershipEvent ─────────────────────────────────────────────────────────

model MembershipEvent {
  id       String   @id @default(cuid())
  memberId String
  gymId    String
  type     String   // 'joined' | 'reactivated' | 'frozen' | 'unfrozen' | 'canceled' | 'plan_changed'
  date     DateTime @default(now())

  // plan_changed: { fromType, toType, fromPriceId, toPriceId, fromAmount, toAmount, currency, effectiveAt }
  meta     Json?
  // GymUser who made the change (null for webhook/system events)
  actorId  String?

  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// ─── MembershipRequest ────────────────────────────────────────────────────────
// Self-service requests submitted from the public /[gymSlug]/membership page.
// Purely a request record + staff notification (Zapier) — does not itself
// mutate the member's status; staff action the request manually.

model MembershipRequest {
  id            String    @id @default(cuid())
  gymId         String
  gym           Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)

  memberEmail   String
  memberName    String
  requestType   String    // 'freeze' | 'unfreeze' | 'cancel'
  reason        String?
  requestedDate DateTime?

  createdAt     DateTime  @default(now())

  @@index([gymId, memberEmail])
}

// ─── FinancialEntry ───────────────────────────────────────────────────────────

model FinancialEntry {
  id          String   @id @default(cuid())
  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  type        String   // 'income' | 'expense'
  category    String
  amount      Float
  description String?
  date        DateTime

  createdAt   DateTime @default(now())

  @@index([gymId, date])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model InventoryItem {
  id         String   @id @default(cuid())
  gymId      String
  gym        Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  name       String
  category   String
  quantity   Int      @default(0)
  lowStockAt Int      @default(5)
  unitCost   Float?
  notes      String?

  // Concessions — set to sell this item through the public ordering page
  price           Float?
  stripeProductId String?
  sectionLabel    String?  // freeform grouping label for the concessions page, e.g. "drinks", "snacks"

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  logs       InventoryLog[]

  @@index([gymId])
}

model InventoryLog {
  id        String        @id @default(cuid())
  gymId     String
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  change    Int      // positive = restock, negative = sale/removal
  reason    String   // 'sale' | 'restock' | 'correction' | 'manual'

  createdAt DateTime @default(now())

  @@index([itemId])
}

// ─── PersonalTrainer ──────────────────────────────────────────────────────────

model PersonalTrainer {
  id    String @id @default(cuid())
  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String?
  bio   String?
  color String?   // hex color for calendar coding

  sessions  PTSession[]
  gymUser   GymUser?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
}

// ─── PTSessionMember (explicit join table) ───────────────────────────────────

model PTSessionMember {
  sessionId String
  memberId  String
  session   PTSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId],  references: [id], onDelete: Cascade)

  @@id([sessionId, memberId])
  @@index([memberId])
}

// ─── PTSession ────────────────────────────────────────────────────────────────

model PTSession {
  id    String @id @default(cuid())
  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  trainerId String
  trainer   PersonalTrainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  members PTSessionMember[]

  title           String?
  date            DateTime
  durationMinutes Int      @default(60)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([trainerId])
}

// ─── RateLimit ───────────────────────────────────────────────────────────────
// Fixed-window counters for public endpoints (see lib/rateLimit.js).
// key = "<bucket>:<ip|email>:<value>"

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
